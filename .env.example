FREE_LLM_MODEL=auto

# Google Cloud Service Account & Calendar / Sheets
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_ID=primary
SHEET_ID=your_google_spreadsheet_id_here

# Clinic Owner Alert Number
