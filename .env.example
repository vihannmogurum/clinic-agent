# Meta WhatsApp Cloud API
META_WA_TOKEN=your_meta_whatsapp_access_token_here
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WA_VERIFY_TOKEN=clinic_verify_secret

# FreeLLMAPI / OpenAI-compatible API
FREE_LLM_API_KEY=your_freellmapi_token_here
FREE_LLM_BASE_URL=https://api.freellmapi.com/v1
FREE_LLM_MODEL=auto

# Google Cloud Service Account & Calendar / Sheets
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_ID=primary
SHEET_ID=your_google_spreadsheet_id_here

# Clinic Owner Alert Number (international format, digits only)
OWNER_PHONE=919876543210

# Server Port
PORT=8000
